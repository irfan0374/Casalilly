DATABASE_URL=postgresql://user:password@localhost:5432/casalilly
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
WHATSAPP_NUMBER=+10000000000
# This backend's own public URL (used for the WhatsApp/social link-preview
# route). In production this is your Render URL, e.g. https://casalilly-api.onrender.com
SITE_BASE_URL=http://localhost:8000
# The deployed frontend's URL (used for CORS + redirecting visitors away
# from the backend's crawler-facing /product/{id} route). In production
# this is your Vercel URL, e.g. https://casalilly.vercel.app
FRONTEND_URL=http://localhost:5180
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me
